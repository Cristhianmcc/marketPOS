{
  "name": "marketpos-print-service",
  "version": "1.0.0",
  "description": "Servicio local de impresión directa para MarketPOS Web",
  "main": "dist/server.js",
  "bin": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "pkg": "tsc && pkg dist/server.js --target node18-win-x64 --output MarketPOS-Print.exe"
  },
  "pkg": {
    "outputPath": "."
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.0",
    "pkg": "^5.8.1"
  }
}
